{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "fcp://schemas/sbom/v1",
  "title": "FCP SBOM v1",
  "type": "object",
  "required": [
    "format",
    "schema_version",
    "bom_format",
    "bom_version",
    "tool_chain",
    "components",
    "dependencies",
    "trust_root",
    "signature"
  ],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "fcp-sbom" },
    "schema_version": { "const": "1.0" },
    "bom_format": {
      "type": "string",
      "enum": ["cyclonedx", "spdx"]
    },
    "bom_version": {
      "type": "string",
      "minLength": 1
    },
    "tool_chain": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["component_id", "name", "version", "hashes", "licenses"],
        "additionalProperties": false,
        "properties": {
          "component_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "hashes": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/definitions/componentDigest" }
          },
          "licenses": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["component_id"],
        "additionalProperties": false,
        "properties": {
          "component_id": { "type": "string", "minLength": 1 },
          "depends_on": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "trust_root": {
      "type": "object",
      "required": ["root_type", "root_id"],
      "additionalProperties": false,
      "properties": {
        "root_type": {
          "type": "string",
          "enum": ["sigstore", "tuf", "manual"]
        },
        "root_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "signature": {
      "type": "object",
      "required": ["algorithm", "key_id", "signature", "signed_fields"],
      "additionalProperties": false,
      "properties": {
        "algorithm": { "const": "ed25519" },
        "key_id": { "type": "string", "minLength": 1 },
        "signature": { "type": "string", "minLength": 1 },
        "signed_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "definitions": {
    "componentDigest": {
      "type": "string",
      "pattern": "^(blake3-256|sha256):[a-f0-9]{64}$"
    }
  }
}
