{
  "policy": {
    "max_restarts": 3,
    "backoff_base_ms": 100,
    "backoff_max_ms": 10000,
    "backoff_multiplier": 2.0,
    "window_seconds": 60
  },
  "crashes": [
    {
      "at_ms": 0,
      "restart": true,
      "delay_ms": 100,
      "reason": null
    },
    {
      "at_ms": 200,
      "restart": true,
      "delay_ms": 200,
      "reason": null
    },
    {
      "at_ms": 600,
      "restart": true,
      "delay_ms": 400,
      "reason": null
    },
    {
      "at_ms": 1500,
      "restart": false,
      "delay_ms": null,
      "reason": "max_restarts_exceeded"
    }
  ]
}
