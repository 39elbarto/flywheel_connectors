{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "fcp://schemas/fwc/connector-lease-status/truth-source-envelope/v1",
  "title": "FWC connector lease status truth-source envelope v1",
  "description": "Top-level provenance envelope for `fwc connector lease status --json`.",
  "type": "object",
  "additionalProperties": true,
  "required": ["status", "command", "subcommand", "schema_version", "_truth_source"],
  "properties": {
    "status": { "type": "string", "minLength": 1 },
    "command": { "const": "connector" },
    "subcommand": { "const": "lease status" },
    "schema_version": {
      "enum": ["1.0.0", "fcp.fwc.truth-source.v1"]
    },
    "_truth_source": {
      "type": "string",
      "enum": ["mesh", "host", "node-local", "offline", "degraded", "fallback-derived", "simulated", "unavailable"]
    },
    "error": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "minLength": 1 }
      }
    }
  }
}
