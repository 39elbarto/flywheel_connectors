{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "fcp://schemas/fwc/proof-queue/v1",
  "title": "FWC Proof Queue v1",
  "description": "Stable JSON file schema for fwc proof enqueue/queue/drain.",
  "type": "object",
  "required": ["schema_version", "jobs"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "fcp.fwc.proof.queue.v1" },
    "jobs": {
      "type": "array",
      "items": { "$ref": "#/$defs/job" }
    }
  },
  "$defs": {
    "job": {
      "type": "object",
      "required": [
        "schema_version",
        "job_id",
        "bead_id",
        "lane",
        "state",
        "priority",
        "estimated_slots",
        "timeout_secs",
        "remote_required",
        "argv",
        "working_directory",
        "target_dir_policy",
        "environment",
        "redaction_policy",
        "admission",
        "created_at_unix_ms",
        "updated_at_unix_ms"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": "fcp.fwc.proof.queue.v1" },
        "job_id": { "type": "string", "minLength": 1 },
        "bead_id": { "type": "string", "pattern": "^flywheel_connectors-[A-Za-z0-9_.-]+$" },
        "lane": {
          "enum": [
            "fmt",
            "workspace-check",
            "workspace-clippy",
            "crate-test",
            "probe-check",
            "scanner-command",
            "custom"
          ]
        },
        "state": { "enum": ["active", "queued", "blocked", "drained", "cancelled"] },
        "priority": { "type": "integer", "minimum": 1 },
        "estimated_slots": { "type": "integer", "minimum": 1 },
        "timeout_secs": { "type": "integer", "minimum": 1, "maximum": 7200 },
        "remote_required": { "type": "boolean" },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "working_directory": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        },
        "target_dir_policy": {
          "enum": ["none", "isolated-temp", "probe-local", "operator-reviewed"]
        },
        "environment": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "redaction_policy": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "admission": {
          "type": "object",
          "required": [
            "decision",
            "capacity_decision",
            "worker_selection",
            "blocker_reason",
            "reason"
          ],
          "additionalProperties": false,
          "properties": {
            "decision": {
              "enum": ["accepted", "queued-capacity", "blocked-capacity"]
            },
            "capacity_decision": {
              "anyOf": [{ "type": "string" }, { "type": "null" }]
            },
            "worker_selection": {
              "anyOf": [{ "type": "string" }, { "type": "null" }]
            },
            "blocker_reason": {
              "anyOf": [{ "type": "string" }, { "type": "null" }]
            },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        "created_at_unix_ms": { "type": "integer", "minimum": 0 },
        "updated_at_unix_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "event": {
      "type": "object",
      "required": [
        "schema_version",
        "event",
        "job_id",
        "bead_id",
        "lane",
        "admission_decision",
        "capacity_decision",
        "worker_selection",
        "state_transition",
        "blocker_reason",
        "target_dir_policy",
        "created_at_unix_ms",
        "updated_at_unix_ms"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": "fcp.fwc.proof.queue-event.v1" },
        "event": { "enum": ["enqueue", "drain", "cancel"] },
        "job_id": { "type": "string", "minLength": 1 },
        "bead_id": { "type": "string", "pattern": "^flywheel_connectors-[A-Za-z0-9_.-]+$" },
        "lane": {
          "enum": [
            "fmt",
            "workspace-check",
            "workspace-clippy",
            "crate-test",
            "probe-check",
            "scanner-command",
            "custom"
          ]
        },
        "admission_decision": {
          "enum": ["accepted", "queued-capacity", "blocked-capacity"]
        },
        "capacity_decision": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        },
        "worker_selection": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        },
        "state_transition": {
          "type": "object",
          "required": ["from", "to"],
          "additionalProperties": false,
          "properties": {
            "from": {
              "anyOf": [
                { "enum": ["active", "queued", "blocked", "drained", "cancelled"] },
                { "type": "null" }
              ]
            },
            "to": { "enum": ["active", "queued", "blocked", "drained", "cancelled"] }
          }
        },
        "blocker_reason": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        },
        "target_dir_policy": {
          "enum": ["none", "isolated-temp", "probe-local", "operator-reviewed"]
        },
        "created_at_unix_ms": { "type": "integer", "minimum": 0 },
        "updated_at_unix_ms": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
