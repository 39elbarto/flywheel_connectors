{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "fcp://schemas/fwc/swarm-pressure/v1",
  "title": "FWC Swarm Pressure v1",
  "description": "Stable JSON output schema for `fwc swarm pressure --json`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "command",
    "schema_version",
    "generated_at",
    "source",
    "pressure_score_0_100",
    "verdict",
    "signals",
    "recommended_agent_slots",
    "recommended_cargo_lanes",
    "remediation_commands",
    "telemetry_event",
    "message",
    "toon"
  ],
  "properties": {
    "status": { "const": "ok" },
    "command": { "const": "swarm pressure" },
    "schema_version": { "const": "fwc.swarm-pressure/v1" },
    "generated_at": { "$ref": "#/$defs/non_empty_string" },
    "source": { "$ref": "#/$defs/source" },
    "pressure_score_0_100": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "verdict": { "$ref": "#/$defs/pressure_status" },
    "signals": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/signal" }
    },
    "recommended_agent_slots": { "$ref": "#/$defs/non_negative_integer" },
    "recommended_cargo_lanes": { "$ref": "#/$defs/non_negative_integer" },
    "remediation_commands": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "telemetry_event": { "$ref": "#/$defs/telemetry_event" },
    "message": { "$ref": "#/$defs/non_empty_string" },
    "toon": { "$ref": "#/$defs/non_empty_string" }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_negative_integer": {
      "type": "integer",
      "minimum": 0
    },
    "pressure_status": {
      "type": "string",
      "enum": ["green", "yellow", "red", "degraded"]
    },
    "redaction_safe_fixture": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^fixture:[A-Za-z0-9._-]+$"
        },
        { "type": "null" }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture", "mode", "caveat"],
      "properties": {
        "fixture": { "$ref": "#/$defs/redaction_safe_fixture" },
        "mode": {
          "type": "string",
          "enum": ["fixture", "local-with-degraded-dependencies"]
        },
        "caveat": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "value", "threshold", "evidence"],
      "properties": {
        "name": { "$ref": "#/$defs/non_empty_string" },
        "status": { "$ref": "#/$defs/pressure_status" },
        "value": { "$ref": "#/$defs/non_empty_string" },
        "threshold": { "$ref": "#/$defs/non_empty_string" },
        "evidence": true
      }
    },
    "telemetry_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "fields"],
      "properties": {
        "name": { "const": "fwc.swarm_pressure.run" },
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verdict",
            "pressure_score",
            "degraded_dependency_count",
            "recommended_agent_slots"
          ],
          "properties": {
            "verdict": { "$ref": "#/$defs/pressure_status" },
            "pressure_score": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "degraded_dependency_count": { "$ref": "#/$defs/non_negative_integer" },
            "recommended_agent_slots": { "$ref": "#/$defs/non_negative_integer" }
          }
        }
      }
    }
  }
}
