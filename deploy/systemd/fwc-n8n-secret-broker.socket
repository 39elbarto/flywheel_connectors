# Repository-tracked unit template for the standalone n8n secret broker.
# This file is not installed, enabled, or started by the connector package.

[Unit]
Description=FCP n8n secret broker Unix socket

[Socket]
ListenStream=/run/fwc/fwc-n8n-secret-broker.sock
Accept=yes

# systemd creates /run/fwc as root; the owner-approved broker group gets the
# only non-root access to the socket.  The group name is intentionally a
# deployment placeholder and must be provisioned before activation.
DirectoryMode=0750
SocketUser=root
SocketGroup=fwc-n8n-broker
SocketMode=0660
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
