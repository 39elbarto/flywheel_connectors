# Repository-tracked unit template for the standalone n8n secret broker.
# This file is not installed, enabled, or started by the connector package.

[Unit]
Description=FCP n8n secret broker request handler (%i)

[Service]
Type=simple
User=root
Group=root

# Fixed packaged path: no shell, PATH lookup, caller-selected executable, or
# Environment= secret material.  The binary must be built with its live-backend
# feature at package time and receives one accepted socket connection on fd 0.
ExecStart=/usr/local/libexec/fwc-n8n-secret-broker
StandardInput=socket
StandardOutput=null
StandardError=journal

# One bounded request per service instance; the broker exits after the frame.
RuntimeMaxSec=30s
TimeoutStartSec=5s
TimeoutStopSec=5s
KillMode=control-group

NoNewPrivileges=yes
# The broker must traverse the peer-owned 0750 home and read its exact 0600
# KDBX while retaining no write-bypass capability. Fixed-path openat2 and
# owner/mode/link-count checks remain authoritative inside the broker.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH
PrivateDevices=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
# Do not set RestrictSUIDSGID here: this host's systemd seccomp profile rejects
# openat2 wholesale when it is enabled. The broker opens only fixed paths with
# O_RDONLY, BENEATH, and NO_SYMLINKS; NoNewPrivileges, read-only mounts, and the
# capability boundary independently prevent setuid/setgid file creation.
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
