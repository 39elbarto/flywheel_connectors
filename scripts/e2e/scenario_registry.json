      "availability",
      "correctness",
      "performance",
      "cost_control"
    ],
    "versioning_policy": {
      "breaking_id_change_requires_registry_version_bump": true,
      "new_scenarios_require_contract_mapping": true,
      "duplicate_ids_or_scripts_forbidden": true
